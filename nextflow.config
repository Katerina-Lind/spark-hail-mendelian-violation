profiles {
  local {
    process.executor = 'local'
    docker.enabled = true
  }
  aws {
    process.executor = 'awsbatch'
    aws.region = 'us-east-1'
    // Set workDir and process.queue through your Seqera compute environment,
    // or supply them at launch time. Never use a guessed queue name.
  }
}
